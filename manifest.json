{
  "manifest_version": 3,
  "name": "Tokens Control — Instant by Default",
  "version": "1.0.0",
  "description": "Defaults every new ChatGPT chat to GPT-5.3 Instant and warns before switching to a heavier (and pricier) model.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
